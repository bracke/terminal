with "../terminal_common/terminal_common.gpr";

library project Terminal_PTY_POSIX is
   --  A one-line C shim reads errno portably (the accessor symbol differs by
   --  platform: __errno_location on glibc, __error on macOS/BSD).
   for Languages use ("Ada", "C");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Library_Dir use "lib";
   for Library_Name use "terminal_pty_posix";
   for Library_Kind use "static";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnatwe");
   end Compiler;
end Terminal_PTY_POSIX;

