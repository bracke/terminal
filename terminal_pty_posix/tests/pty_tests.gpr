with "../terminal_pty_posix.gpr";
with "aunit";

project PTY_Tests is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use
     ("pty_status_smoke.adb",
      "pty_resize_smoke.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata");
   end Compiler;
end PTY_Tests;
