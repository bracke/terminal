with "../../glfw_vulkan/glfw_vulkan.gpr";
with "../../../textrender/textrender.gpr";
with "../../../jpeglib/jpeglib.gpr";
with "../../../giflib/giflib.gpr";
with "../../../pictlib/pictlib.gpr";
with "df_vulkan";
with "zlib";

project Graphics_Pipeline_Fuzz is
   for Languages use ("Ada", "C");
   for Source_Dirs use
     (".",
      "../src",
      "../src/platform/posix",
      "../../terminal_core/src",
      "../../terminal_common/src",
      "../../terminal_core/fuzz");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use
     ("graphics_pipeline_fuzz_target.adb",
      "afl_coverage_smoke.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022",
         "-gnata",
         "-fno-omit-frame-pointer",
         "-fno-pie",
         "-fsanitize-coverage=trace-pc");
      for Default_Switches ("C") use
        ("-O2", "-fno-omit-frame-pointer", "-fno-pie");
   end Compiler;

   package Linker is
      for Switches ("Ada") use
        ("-no-pie", "-lglfw", "-lvulkan", "-lharfbuzz");
      for Switches ("C") use ("-no-pie");
   end Linker;
end Graphics_Pipeline_Fuzz;
