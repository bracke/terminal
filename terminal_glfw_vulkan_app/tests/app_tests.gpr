with "../terminal_glfw_vulkan_app.gpr";
with "aunit";

project App_Tests is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use
     ("colour_glyph_submit_smoke.adb",
      "vulkan_submit_smoke.adb",
      "app_profile_smoke.adb",
      "vulkan_presenter_smoke.adb",
      "vulkan_device_smoke.adb",
      "gui_present_smoke.adb",
      "shader_loader_smoke.adb",
      "font_discovery_smoke.adb",
      "text_shaper_smoke.adb",
      "renderer_metrics_smoke.adb",
      "pty_core_integration_smoke.adb",
      "pty_m1_commands_smoke.adb",
      "pty_program_progression_smoke.adb",
      "input_map_smoke.adb",
      "selection_smoke.adb",
      "hyperlink_smoke.adb",
      "clipboard_osc52_smoke.adb",
      "diagnostics_smoke.adb",
      "scrollback_view_smoke.adb",
      "render_policy_smoke.adb",
      "theme_config_smoke.adb",
      "graphics_capabilities_smoke.adb",
      "tabs_smoke.adb",
      "splits_smoke.adb",
      "cursor_blink_smoke.adb",
      "text_blink_smoke.adb",
      "queue_smoke.adb",
      "resize_smoke.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnatwe");
   end Compiler;

   --  MSYS2 names these libraries differently from every Unix: libglfw3.dll.a
   --  and libvulkan-1.dll.a, so -lglfw and -lvulkan find nothing there. Same
   --  scenario variable the PTY backend uses, so one setting picks the host.
   type Link_OS_Kind is ("posix", "windows");
   Link_Host : Link_OS_Kind := external ("TERMINAL_PTY_OS", "posix");

   package Linker is
      case Link_Host is
         when "windows" =>
            for Switches ("Ada") use ("-lglfw3", "-lvulkan-1", "-lharfbuzz");
         when "posix" =>
            for Switches ("Ada") use ("-lglfw", "-lvulkan", "-lharfbuzz");
      end case;
   end Linker;
end App_Tests;
