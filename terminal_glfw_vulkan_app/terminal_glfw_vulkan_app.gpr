with "../terminal_common/terminal_common.gpr";
with "../terminal_core/terminal_core.gpr";
with "../terminal_pty_posix/terminal_pty_posix.gpr";
with "../glfw_vulkan/glfw_vulkan.gpr";
with "../../textrender/textrender.gpr";
with "df_vulkan";
--  cryptolib's generated config carries Alire_Host_OS; use it directly (its own
--  gpr is not withable here, and terminal_glfw_vulkan_app's config is not
--  generated during the top-level build -- only when this crate is built alone).
with "../../cryptolib/config/cryptolib_config.gpr";

project Terminal_GLFW_Vulkan_App is
   --  cryptolib keeps its OS_Random backend in src-<os> (getrandom on Linux,
   --  getentropy on macOS, BCrypt on Windows). We compile cryptolib's sources
   --  directly, so pick the same per-host directory it would -- hardcoding
   --  src-linux left macOS/Windows linking against the Linux syscalls.
   for Source_Dirs use
     ("src",
      "../../zlib/src",
      "../../zlib/config",
      "../../cryptolib/src",
      "../../cryptolib/config",
      "../../cryptolib/src-" & Cryptolib_Config.Alire_Host_OS);
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("terminal_app_main.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnatwe");
   end Compiler;

   package Linker is
      for Switches ("Ada") use ("-lglfw", "-lvulkan", "-lharfbuzz");
   end Linker;
   --  Bytes out as bytes in. Alire's generated switches carry -gnatW8 and the
   --  binder takes its run-time encoding from the same place, which makes
   --  Ada.Text_IO encode every byte above 127 a second time on the way out:
   --  text that was already UTF-8 -- an accented path, an internationalized
   --  domain name, a translated message -- came out doubled. -Wb is the
   --  compiler default and leaves the bytes alone.
   package Binder is
      for Switches ("Ada") use ("-Wb");
   end Binder;

end Terminal_GLFW_Vulkan_App;
