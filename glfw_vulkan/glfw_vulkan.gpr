with "../c_string_ownership/c_string_ownership.gpr";
with "df_vulkan";

library project GLFW_Vulkan is
   for Languages use ("Ada", "C");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Library_Dir use "lib";
   for Library_Name use "glfw_vulkan";
   for Library_Kind use "static";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnatwe");
      for Default_Switches ("C") use
        ("-Wall", "-Wextra", "-Wpedantic", "-Werror");
   end Compiler;
end GLFW_Vulkan;
