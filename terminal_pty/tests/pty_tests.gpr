with "../terminal_pty.gpr";
with "../config/terminal_pty_build_config.gpr";
with "aunit";

project PTY_Tests is
   type Test_OS_Kind is ("posix", "windows");
   Test_Host : Test_OS_Kind := external ("TERMINAL_PTY_OS", "posix");
   C_Switches := ("-Wall", "-Wextra", "-Wpedantic", "-Werror");

   case Test_Host is
      when "windows" =>
         for Languages use ("Ada", "C");
         for Source_Dirs use (".", "platform/windows");
         C_Switches := C_Switches
           & Terminal_PTY_Build_Config.C_Testing_Switches;
         case Terminal_PTY_Build_Config.Build_Mode is
            when "testing" =>
               for Object_Dir use "obj/windows/testing";
            when "production" =>
               for Object_Dir use "obj/windows";
         end case;
         for Exec_Dir use "bin/windows";
         for Main use
           ("pty_status_smoke.adb",
            "pty_env_smoke.adb",
            "pty_resize_smoke.adb",
            "pty_close_smoke.adb",
            "pty_windows_spawn_failure_smoke.adb",
            "pty_windows_lifecycle_smoke.adb");
      when "posix" =>
         for Languages use ("Ada", "C");
         for Source_Dirs use (".", "platform/posix");
         for Object_Dir use "obj/posix";
         for Exec_Dir use "bin";
         for Main use
           ("pty_status_smoke.adb",
            "pty_env_smoke.adb",
            "pty_resize_smoke.adb",
            "pty_close_smoke.adb",
            "pty_spawn_failure_smoke.adb",
            "pty_windows_lifecycle_smoke.adb");
   end case;

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata");
      for Default_Switches ("C") use C_Switches;
   end Compiler;
end PTY_Tests;
