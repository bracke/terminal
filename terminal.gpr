project Terminal extends "terminal_glfw_vulkan_app/terminal_glfw_vulkan_app.gpr" is
   type Build_OS_Kind is ("posix", "windows");
   Build_Host : Build_OS_Kind := external ("TERMINAL_PTY_OS", "posix");

   case Build_Host is
      when "windows" =>
         for Object_Dir use "obj/windows";
         for Exec_Dir use "bin/windows";
      when "posix" =>
         for Object_Dir use "obj/posix";
         for Exec_Dir use "bin";
   end case;

   package Builder is
      for Executable ("terminal_app_main.adb") use "terminal";
   end Builder;
end Terminal;
